<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Duo 展示</string>
			<key>footerText</key>
			<string>关闭后隐藏 Duo 状态环/读数；轮播页面不受影响，可独立使用。Duo 尺寸与轮播尺寸硬捆绑，单独调整会连带轮播异常，因此不提供 Duo 尺寸调节。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>显示 Duo</string>
			<key>key</key>
			<string>soloPlusShowDuo</string>
			<key>defaults</key>
			<string>com.oakstheawesome.solo</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.chenlin8023.soloplus/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Duo 细节</string>
			<key>footerText</key>
			<string>时间开关只作用于 Solo 时钟文字（UnduoClockMirroredLabel）；电量挂在 Duo 整行下方、与读数同字族字重；下方图标开关用于去掉定位箭头等非电量符号。位置不合适时用「电量上下微调」推一档。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>显示 Duo 时间</string>
			<key>key</key>
			<string>soloPlusShowDuoTime</string>
			<key>defaults</key>
			<string>com.oakstheawesome.solo</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.chenlin8023.soloplus/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Duo 下方电量</string>
			<key>key</key>
			<string>soloPlusShowDuoBattery</string>
			<key>defaults</key>
			<string>com.oakstheawesome.solo</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.chenlin8023.soloplus/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>隐藏 Duo 下方图标</string>
			<key>key</key>
			<string>soloPlusHideDuoIcons</string>
			<key>defaults</key>
			<string>com.oakstheawesome.solo</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.chenlin8023.soloplus/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>label</key>
			<string>电量上下微调</string>
			<key>key</key>
			<string>soloPlusDuoBatteryOffset</string>
			<key>defaults</key>
			<string>com.oakstheawesome.solo</string>
			<key>default</key>
			<real>0</real>
			<key>validTitles</key>
			<array>
				<string>-8</string>
				<string>-4</string>
				<string>0</string>
				<string>+4</string>
				<string>+8</string>
			</array>
			<key>validValues</key>
			<array>
				<real>-8</real>
				<real>-4</real>
				<real>0</real>
				<real>4</real>
				<real>8</real>
			</array>
			<key>PostNotification</key>
			<string>com.chenlin8023.soloplus/reload</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>数据标识</string>
			<key>footerText</key>
			<string>只调整 Duo 状态读数里的数据标识（5G/LTE/3G/E/Wi-Fi）；5G 固定显示为 5G 加小号同基线 A，其余保持不变。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>label</key>
			<string>标识字号</string>
			<key>key</key>
			<string>soloPlusDataFontScale</string>
			<key>defaults</key>
			<string>com.oakstheawesome.solo</string>
			<key>default</key>
			<real>1.0</real>
			<key>validTitles</key>
			<array>
				<string>小</string>
				<string>默认</string>
				<string>大</string>
				<string>特大</string>
			</array>
			<key>validValues</key>
			<array>
				<real>0.8</real>
				<real>1.0</real>
				<real>1.2</real>
				<real>1.4</real>
			</array>
			<key>PostNotification</key>
			<string>com.chenlin8023.soloplus/reload</string>
			<key>footerText</key>
			<string></string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>label</key>
			<string>标识字重</string>
			<key>key</key>
			<string>soloPlusDataFontWeight</string>
			<key>defaults</key>
			<string>com.oakstheawesome.solo</string>
			<key>default</key>
			<real>0.0</real>
			<key>validTitles</key>
			<array>
				<string>跟随</string>
				<string>细</string>
				<string>常规</string>
				<string>中粗</string>
				<string>粗</string>
			</array>
			<key>validValues</key>
			<array>
				<real>0.0</real>
				<real>1.0</real>
				<real>2.0</real>
				<real>3.0</real>
				<real>4.0</real>
			</array>
			<key>PostNotification</key>
			<string>com.chenlin8023.soloplus/reload</string>
		</dict>
	</array>
</dict>
</plist>
